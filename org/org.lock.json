 "workflow": {
  "gates": {
   "acceptance-criteria-defined": "Testable acceptance criteria exist before implementation starts.",
   "acceptance-criteria-met": "Each acceptance criterion is mapped to evidence.",
   "adr-recorded": "Significant technical decisions have an ADR with alternatives and trade-offs.",
   "business-review-passed": "Business Analyst critique resolved or residual risk accepted by the business owner.",
   "changelog-entry": "CHANGELOG.md has an entry for the change.",
   "checks-pass": "Repository tests, lint, type-check and build pass (or are proven not applicable), with output.",
   "diff-reviewed": "Someone other than the implementer reviewed the diff.",
   "domain-reviews-passed": "Every activated Tier 2 reviewer (security, database, a11y, ...) returned PASS.",
   "license-gate": "Every new third-party license passes `oeo license <SPDX>`.",
   "outcome-measurable": "The success metric can actually be measured after release.",
   "regression-test": "The fix or feature has a test that fails without the change.",
   "rollback-plan": "A tested or reasoned rollback path is written down.",
   "version-bump": "Version follows SemVer for the change type."
  },
  "stages": [
   {
    "exit": "class recorded with rationale; misclassification later triggers re-triage, never silent scope creep",
    "id": "intake",
    "n": 0,
    "name": "Intake & Triage",
    "output": "activation plan from `oeo route` (class, rule, roles, gates) logged to .oeo/activation-log.jsonl",
    "owner": "project-manager"
   },
   {
    "exit": "business-owner confirms the objective; Class B may use a 5-line brief (outcome + acceptance criteria)",
    "id": "discovery",
    "n": 1,
    "name": "Business Discovery",
    "output": ".oeo/<engagement>/brief.md (users, problem, outcome, metrics, scope/non-goals, constraints, evidence, risks)",
    "owner": "business-analyst"
   },
   {
    "exit": "criteria satisfied, or business-owner accepts a documented residual risk",
    "id": "business-review",
    "n": 2,
    "name": "Independent Business Review",
    "output": "structured critique (finding, evidence, impact, severity, corrective action) or PASS",
    "owner": "business-analyst"
   },
   {
    "exit": "every task has one owner and testable acceptance criteria",
    "id": "planning",
    "n": 3,
    "name": "Product & Delivery Planning",
    "output": ".oeo/<engagement>/plan.md (deliverables, acceptance criteria, sequencing, owners, file partition, tests, risks, DoD)",
    "owner": "project-manager"
   },
   {
    "exit": "CTO checklist passed; no new dependency, service or abstraction without demonstrated need",
    "id": "architecture",
    "n": 4,
    "name": "Architecture & Engineering Review",
    "output": "ADR in docs/adr/ (context, options, trade-offs, decision, consequences) for significant decisions",
    "owner": "technical-architect"
   },
   {
    "exit": "implementer handoff lists changed files, commands run and their real output",
    "id": "implement",
    "n": 5,
    "name": "Design & Implementation",
    "output": "small diffs + handoffs; design acceptance criteria when UI is touched",
    "owner": "technical-lead"
   },
   {
    "exit": "all class gates PASS; the implementer is never the sole authority on correctness",
    "id": "verify",
    "n": 6,
    "name": "Independent Verification",
    "output": ".oeo/<engagement>/verification.md (gate, command, result, evidence) and findings",
    "owner": "qa-verifier"
   },
   {
    "exit": "human authorization for publishing, deploying or any irreversible action",
    "id": "release",
    "n": "7a",
    "name": "Release",
    "output": "SemVer bump, CHANGELOG entry, release notes, tag, rollback plan",
    "owner": "release-manager"
   },
   {
    "exit": "shipped code is never reported as business success by itself",
    "id": "outcome",
    "n": "7b",
    "name": "Business Outcome Review",
    "output": "outcome report separating requirements met / tests passed / released / outcomes observed / outcomes unverified",
    "owner": "business-analyst"
   },
   {
    "exit": "decisions communicated publicly and respectfully per CODE_OF_CONDUCT.md",
    "id": "community",
    "n": 8,
    "name": "Community & Feedback Loop",
    "output": "labeled, reproducible issues; defects re-enter Stage 0, product gaps re-enter Stage 1",
    "owner": "oss-maintainer"
   }
  ]
 }
