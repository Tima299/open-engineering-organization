  "classification": [
   {
    "class": "D",
    "rule": "organizational-work",
    "when": {
     "risky_domain": false,
     "types_any": [
      "release",
      "governance",
      "licensing",
      "community",
      "marketing"
     ]
    }
   },
   {
    "class": "C",
    "rule": "significant-type",
    "when": {
     "types_any": [
      "architecture",
      "new-product",
      "incident"
     ]
    }
   },
   {
    "class": "C",
    "rule": "risky-domain",
    "when": {
     "risky_domain": true
    }
   },
   {
    "class": "C",
    "rule": "risk-signal",
    "when": {
     "signals_any": [
      "new-surface",
      "breaking-change",
      "high-risk",
      "ai-feature"
     ]
    }
   },
   {
    "class": "C",
    "rule": "large-change",
    "when": {
     "files_gt": 15
    }
   },
   {
    "class": "A",
    "rule": "trivial-change",
    "when": {
     "files_lte": 2,
     "lines_lte": 20,
     "no_triggers": true,
     "types_any": [
      "trivial"
     ]
    }
   },
   {
    "class": "B",
    "rule": "standard-default",
    "when": {}
   }
