+# SPDX-License-Identifier: Apache-2.0
+"""Dashboard: one self-contained HTML page of open tasks per owner."""
+import datetime
+from html import escape
+
+from .reporting import open_task_counts
+
+_CSS = """\
+:root {
+  color-scheme: light dark;
+  --bg: #f6f7f9;
+  --card: #ffffff;
+  --text: #1a1d23;
+  --muted: #4a5260;
+  --border: #8a93a3;
+  --overdue-bg: #fdecec;
+  --overdue-fg: #9b1c1c;
+  --focus: #1d4ed8;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0f1217;
+    --card: #1a1f27;
+    --text: #e8ebf0;
+    --muted: #aab2c0;
+    --border: #6b7586;
+    --overdue-bg: #4a1a1a;
+    --overdue-fg: #ffb4b4;
+    --focus: #8ab4ff;
+  }
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  padding: 1rem;
+  background: var(--bg);
+  color: var(--text);
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  line-height: 1.5;
+}
+h1 { margin: 0; font-size: 1.5rem; }
+h2 { margin: 0; font-size: 1.125rem; overflow-wrap: anywhere; }
+header { margin-bottom: 1rem; }
+header p { margin: 0.25rem 0 0; color: var(--muted); }
+ul { margin: 0; padding: 0; list-style: none; }
+.owners {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
+  gap: 1rem;
+}
+.owners > li { min-width: 0; }
+section, .empty {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 0.5rem;
+  padding: 1rem;
+}
+.stats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.25rem 0 0.75rem; color: var(--muted); }
+.badge {
+  display: inline-block;
+  padding: 0 0.5rem;
+  border: 1px solid var(--overdue-fg);
+  border-radius: 999px;
+  background: var(--overdue-bg);
+  color: var(--overdue-fg);
+  font-weight: 700;
+}
+.task {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.75rem;
+  padding: 0.5rem 0 0.5rem 0.5rem;
+  border-top: 1px solid var(--border);
+  border-left: 4px solid transparent;
+}
+.task.overdue { border-left-color: var(--overdue-fg); }
+.title { flex: 1 1 100%; min-width: 0; overflow-wrap: anywhere; }
+.date, .none, .task time { color: var(--muted); }
+.none { font-style: italic; }
+@media (prefers-reduced-motion: reduce) { * { animation: none; transition: none; } }
+"""
+
+
+def _parse_due(due):
+    if not due:
+        return None
+    try:
+        return datetime.date.fromisoformat(due)
+    except (TypeError, ValueError):
+        return None
+
+
+def _sort_key(task):
+    parsed = _parse_due(task["due"])
+    if parsed is not None:
+        return (0, parsed, task["id"])
+    return (1, datetime.date.max, task["id"])
+
+
+def _task_row(task, today):
+    parsed = _parse_due(task["due"])
+    title = escape(task["title"])
+    if parsed is None and task["due"]:
+        when = f'<span class="none">{escape(str(task["due"]))}</span>'
+        return f'<li class="task"><span class="title">{title}</span>{when}</li>'
+    if parsed is None:
+        when = '<span class="none">No due date</span>'
+        return f'<li class="task"><span class="title">{title}</span>{when}</li>'
+    when = f'<time datetime="{parsed.isoformat()}">{parsed.isoformat()}</time>'
+    if parsed < today:
+        status = '<span class="badge">Overdue</span>'
+        css = "task overdue"
+    elif parsed == today:
+        status = '<span class="date">Due today</span>'
+        css = "task"
+    else:
+        status = '<span class="date">Upcoming</span>'
+        css = "task"
+    return f'<li class="{css}"><span class="title">{title}</span>{when}{status}</li>'
+
+
+def _card(index, owner, count, tasks, today):
+    overdue = sum(1 for t in tasks if (d := _parse_due(t["due"])) is not None and d < today)
+    if overdue:
+        overdue_html = f'<span class="badge">{overdue} overdue</span>'
+    else:
+        overdue_html = "<span>0 overdue</span>"
+    rows = "".join(_task_row(t, today) for t in sorted(tasks, key=_sort_key))
+    heading = f"owner-{index}"
+    return (
+        f'<li><section aria-labelledby="{heading}">'
+        f'<h2 id="{heading}">{escape(owner)}</h2>'
+        f'<p class="stats"><span>{count} open</span>{overdue_html}</p>'
+        f"<ul>{rows}</ul></section></li>"
+    )
+
+
+def render_dashboard(store, today=None):
+    """Return one self-contained HTML page of open tasks per owner; `today` defaults to date.today()."""
+    today = today or datetime.date.today()
+    counts = open_task_counts(store)
+    by_owner = {}
+    rows = store.conn.execute("SELECT id, owner, title, due FROM tasks WHERE done = 0")
+    for row in rows:
+        by_owner.setdefault(row["owner"], []).append(row)
+    if counts:
+        cards = "".join(
+            _card(i, owner, count, by_owner.get(owner, []), today)
+            for i, (owner, count) in enumerate(counts.items(), 1))
+        body = f'<ul class="owners">{cards}</ul>'
+    else:
+        body = '<p role="status" class="empty">No open tasks. Nothing is waiting on anyone.</p>'
+    iso = today.isoformat()
+    return (
+        '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+        f"<title>Taskboard</title>\n<style>\n{_CSS}</style>\n</head>\n<body>\n"
+        "<header><h1>Taskboard</h1>"
+        f'<p>Open tasks per owner, as of <time datetime="{iso}">{iso}</time></p></header>\n'
+        f"<main>{body}</main>\n</body>\n</html>\n"
+    )
