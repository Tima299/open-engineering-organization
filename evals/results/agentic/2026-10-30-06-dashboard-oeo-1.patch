+++ b/tests/test_dashboard.py
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: Apache-2.0
+import re
+import unittest
+
+from taskboard import TaskStore
+from taskboard.dashboard import render_dashboard
+
+ITEM = re.compile(r'<li( class="overdue")?>(.*?)</li>', re.S)
+
+
+def items(page):
+    """Return (is_overdue, inner_html) for every task list item in the page."""
+    return [(m.group(1) is not None, m.group(2)) for m in ITEM.finditer(page)]
+
+
+class DashboardTests(unittest.TestCase):
+    def test_page_is_self_contained_and_responsive(self):  # criterion 1
+        store = TaskStore()
+        store.add("ana", "write docs", due="2030-01-31")
+        page = render_dashboard(store, today="2030-01-01")
+        self.assertTrue(page.startswith("<!DOCTYPE html>"))
+        self.assertIn('<meta name="viewport"', page)
+        self.assertRegex(page, r"@media \(max-width: \d+rem\)")
+        self.assertNotRegex(page, r"<link\b|<script\b|<img\b|@import|url\(|https?://")
+
+    def test_open_task_count_per_owner_excludes_done(self):  # criterion 2
+        store = TaskStore()
+        store.add("ana", "a1")
+        store.add("ana", "a2")
+        finished = store.add("ana", "a3")
+        store.complete("ana", finished)
+        store.add("ben", "b1")
+        done_only = store.add("cy", "c1")
+        store.complete("cy", done_only)
+        page = render_dashboard(store, today="2030-01-01")
+        self.assertIn('<p class="count">2 open</p>', page)
+        self.assertIn('<p class="count">1 open</p>', page)
+        self.assertEqual(page.count('<p class="count">'), 2)
+        self.assertNotIn("<h2>cy</h2>", page)
+
+    def test_lists_open_tasks_with_due_or_no_due_date(self):  # criterion 3
+        store = TaskStore()
+        store.add("ana", "pay rent", due="2030-02-01")
+        store.add("ana", "call mum")
+        finished = store.add("ana", "old chore", due="2030-02-02")
+        store.complete("ana", finished)
+        page = render_dashboard(store, today="2030-01-01")
+        texts = [inner for _, inner in items(page)]
+        self.assertEqual(len(texts), 2)
+        self.assertIn("pay rent", texts[0])
+        self.assertIn("due 2030-02-01", texts[0])
+        self.assertIn("call mum", texts[1])
+        self.assertIn("no due date", texts[1])
+        self.assertNotIn("old chore", page)
+
+    def test_overdue_tasks_have_class_and_text_label(self):  # criterion 4
+        store = TaskStore()
+        store.add("ana", "late", due="2029-12-31")
+        store.add("ana", "due today", due="2030-01-01")
+        store.add("ana", "future", due="2030-01-02")
+        store.add("ana", "no date")
+        page = render_dashboard(store, today="2030-01-01")
+        flags = items(page)
+        self.assertEqual(len(flags), 4)
+        overdue = [inner for is_over, inner in flags if is_over]
+        self.assertEqual(len(overdue), 1)
+        self.assertIn("late", overdue[0])
+        self.assertIn("Overdue", overdue[0])  # visible text, not colour only
+        for is_over, inner in flags:
+            if "late" not in inner:
+                self.assertFalse(is_over, inner)
+                self.assertNotIn("Overdue", inner)
+
+    def test_today_defaults_to_local_date(self):  # criterion 4, default path
+        store = TaskStore()
+        store.add("ana", "ancient", due="2000-01-01")
+        self.assertIn('class="overdue"', render_dashboard(store))
+
+    def test_user_data_is_escaped(self):  # criterion 5
+        store = TaskStore()
+        store.add('<b>ana</b>', '<script>alert("x")</script>', due='2029-01-01"><i>')
+        page = render_dashboard(store, today="2030-01-01")
+        self.assertNotIn("<script>", page)
+        self.assertNotIn("<b>ana</b>", page)
+        self.assertNotIn("<i>", page)
+        self.assertIn("&lt;b&gt;ana&lt;/b&gt;", page)
+        self.assertIn("&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;", page)
+        self.assertIn("due 2029-01-01&quot;&gt;&lt;i&gt;", page)
+
+    def test_empty_store_renders_valid_page_with_empty_state(self):  # criterion 5
+        page = render_dashboard(TaskStore(), today="2030-01-01")
+        self.assertTrue(page.startswith("<!DOCTYPE html>"))
+        self.assertIn("</html>", page)
+        self.assertIn('class="empty"', page)
+        self.assertIn("No open tasks", page)
+        self.assertEqual(items(page), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
