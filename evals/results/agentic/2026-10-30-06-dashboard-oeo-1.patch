+# SPDX-License-Identifier: Apache-2.0
+"""Self-contained, responsive HTML dashboard for Taskboard."""
+import datetime
+import html
+
+from .reporting import open_task_counts
+
+_CSS = """
+body { font-family: system-ui, sans-serif; margin: 0; padding: 1rem; background: #f6f6f8; color: #1d1d1f; }
+h1 { font-size: 1.5rem; margin: 0 0 1rem; }
+.grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
+.card { background: #fff; border-radius: 0.5rem; padding: 1rem; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1); }
+.card h2 { font-size: 1.1rem; margin: 0 0 0.25rem; overflow-wrap: anywhere; }
+.count { color: #555; margin: 0 0 0.5rem; }
+ul { list-style: none; margin: 0; padding: 0; }
+li { padding: 0.4rem 0; border-top: 1px solid #eee; overflow-wrap: anywhere; }
+.due { color: #555; font-size: 0.9rem; }
+li.overdue .due { color: #8a1c1c; font-weight: 600; }
+.badge { display: inline-block; margin-left: 0.4rem; padding: 0 0.4rem; border: 1px solid #8a1c1c; border-radius: 0.25rem; color: #8a1c1c; font-size: 0.8rem; font-weight: 600; }
+.empty { color: #555; font-style: italic; }
+@media (max-width: 30rem) {
+  body { padding: 0.5rem; }
+  h1 { font-size: 1.25rem; }
+}
+"""
+
+
+def render_dashboard(store, today=None):
+    """Return one self-contained HTML document summarising open tasks per owner.
+
+    `today` is an ISO date string (YYYY-MM-DD) used for overdue checks; it defaults
+    to the local date. Tasks with a due date before `today` are marked overdue.
+    """
+    if today is None:
+        today = datetime.date.today().isoformat()
+    elif isinstance(today, datetime.date):
+        today = today.isoformat()
+
+    counts = open_task_counts(store)
+    rows = store.conn.execute(
+        "SELECT owner, title, due FROM tasks WHERE done = 0 ORDER BY owner, id").fetchall()
+    tasks_by_owner = {}
+    for row in rows:
+        tasks_by_owner.setdefault(row["owner"], []).append(row)
+
+    cards = []
+    for owner in sorted(counts):
+        items = []
+        for row in tasks_by_owner.get(owner, []):
+            due = row["due"]
+            if due:
+                overdue = due < today
+                due_text = f"due {html.escape(due)}"
+            else:
+                overdue = False
+                due_text = "no due date"
+            css = ' class="overdue"' if overdue else ""
+            badge = '<span class="badge">Overdue</span>' if overdue else ""
+            items.append(
+                f'<li{css}>{html.escape(row["title"])} '
+                f'<span class="due">{due_text}</span>{badge}</li>')
+        cards.append(
+            '<section class="card">'
+            f'<h2>{html.escape(owner)}</h2>'
+            f'<p class="count">{counts[owner]} open</p>'
+            f'<ul>{"".join(items)}</ul>'
+            '</section>')
+
+    if cards:
+        body = f'<div class="grid">{"".join(cards)}</div>'
+    else:
+        body = '<p class="empty">No open tasks. Nothing to show yet.</p>'
+
+    return (
+        '<!DOCTYPE html>\n'
+        '<html lang="en">\n'
+        '<head>\n'
+        '<meta charset="utf-8">\n'
+        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+        '<title>Taskboard dashboard</title>\n'
+        f'<style>{_CSS}</style>\n'
+        '</head>\n'
+        '<body>\n'
+        '<h1>Taskboard dashboard</h1>\n'
+        f'{body}\n'
+        '</body>\n'
+        '</html>\n'
+    )
