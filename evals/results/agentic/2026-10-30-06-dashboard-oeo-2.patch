+# SPDX-License-Identifier: Apache-2.0
+"""Dashboard: one self-contained HTML page of open tasks per owner."""
+from datetime import date
+from html import escape
+
+from .reporting import open_task_counts
+
+_CSS = """
+:root{color-scheme:light dark;--bg:#fff;--fg:#1a1a1a;--card:#f4f5f7;--muted:#555;--bad-bg:#fde8e8;--bad-fg:#8a1010;--bad-bd:#c62828}
+@media (prefers-color-scheme: dark){:root{--bg:#121417;--fg:#eceff1;--card:#1f2329;--muted:#aab2bb;--bad-bg:#4a1c1c;--bad-fg:#ffd6d6;--bad-bd:#ff6b6b}}
+*{box-sizing:border-box}
+body{margin:0;padding:1rem;background:var(--bg);color:var(--fg);font:1rem/1.5 system-ui,sans-serif;overflow-wrap:anywhere}
+h1{font-size:1.5rem;margin:0 0 1rem}
+h2{font-size:1.1rem;margin:0 0 .5rem}
+ul{list-style:none;margin:0;padding:0}
+.summary{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.5rem}
+.summary li{background:var(--card);border-radius:.5rem;padding:.25rem .75rem}
+.count{font-weight:700}
+.owners{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}
+.owner{background:var(--card);border-radius:.5rem;padding:1rem}
+.task{padding:.4rem .5rem;border-left:.3rem solid transparent}
+.due{display:block;color:var(--muted);font-size:.875rem}
+.task.overdue{background:var(--bad-bg);color:var(--bad-fg);border-left-color:var(--bad-bd)}
+.task.overdue .due{color:inherit}
+.flag{font-weight:700}
+"""
+
+
+def _is_overdue(due, today):
+    try:
+        return date.fromisoformat(due[:10]) < today
+    except (TypeError, ValueError):
+        return False
+
+
+def render_dashboard(store, today=None):
+    """Return a self-contained HTML5 page: open tasks per owner, overdue flagged."""
+    today = today or date.today()
+    counts = open_task_counts(store)
+    rows = store.conn.execute(
+        "SELECT id, owner, title, due FROM tasks WHERE NOT done").fetchall()
+    by_owner = {}
+    for r in sorted(rows, key=lambda r: (not r["due"], r["due"] or "", r["id"])):
+        by_owner.setdefault(r["owner"], []).append(r)
+    owners = sorted(counts, key=lambda o: (-counts[o], o))
+
+    summary, sections = [], []
+    for owner in owners:
+        name = escape(owner)
+        late = sum(_is_overdue(r["due"], today) for r in by_owner[owner])
+        extra = f' <span class="due">{late} overdue</span>' if late else ""
+        summary.append(f'<li><span class="name">{name}</span> '
+                       f'<span class="count">{counts[owner]}</span>{extra}</li>')
+        items = []
+        for r in by_owner[owner]:
+            over = _is_overdue(r["due"], today)
+            due = f"due {escape(r['due'])}" if r["due"] else "no due date"
+            flag = '<span class="flag">OVERDUE</span> ' if over else ""
+            cls = "task overdue" if over else "task"
+            items.append(f'<li class="{cls}">{escape(r["title"])}'
+                         f'<span class="due">{flag}{due}</span></li>')
+        sections.append(f'<section class="owner"><h2>{name}</h2>'
+                        f'<ul>{"".join(items)}</ul></section>')
+
+    if owners:
+        body = (f'<h2>Open tasks per owner</h2><ul class="summary">'
+                f'{"".join(summary)}</ul><div class="owners">{"".join(sections)}</div>')
+    else:
+        body = "<p>No open tasks.</p>"
+    return ('<!DOCTYPE html>\n<html lang="en"><head><meta charset="utf-8">'
+            '<meta name="viewport" content="width=device-width, initial-scale=1">'
+            f'<title>Taskboard dashboard</title><style>{_CSS}</style></head>'
+            f'<body><h1>Taskboard dashboard</h1>{body}</body></html>\n')
