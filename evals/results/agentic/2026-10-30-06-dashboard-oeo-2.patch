+++ b/tests/test_dashboard.py
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+import re
+import unittest
+from datetime import date
+
+from taskboard import TaskStore
+from taskboard.dashboard import render_dashboard
+
+TODAY = date(2026, 10, 30)
+
+
+def render(store):
+    return render_dashboard(store, today=TODAY)
+
+
+class DashboardTests(unittest.TestCase):
+    def test_self_contained_document(self):
+        store = TaskStore()
+        store.add("ana", "x", due="2026-01-01")
+        html = render(store)
+        self.assertTrue(html.lstrip().lower().startswith("<!doctype html>"))
+        self.assertIn('<html lang="en">', html)
+        self.assertIn("<title>", html)
+        self.assertIn('name="viewport"', html)
+        self.assertIn("prefers-color-scheme: dark", html)
+        self.assertNotIn("<script", html)
+        self.assertNotRegex(html, r"(?i)(src|href)=|url\(|@import|https?://")
+
+    def test_counts_per_owner_exclude_done(self):
+        store = TaskStore()
+        store.add("ana", "a1")
+        store.add("ana", "a2")
+        store.add("ben", "b1")
+        done = store.add("cy", "finished")
+        store.complete("cy", done)
+        html = render(store)
+        self.assertRegex(html, r'<span class="name">ana</span>\s*<span class="count">2</span>')
+        self.assertRegex(html, r'<span class="name">ben</span>\s*<span class="count">1</span>')
+        self.assertNotIn("finished", html)
+        self.assertNotIn(">cy<", html)
+        # ordered by count desc then name
+        self.assertLess(html.index(">ana<"), html.index(">ben<"))
+
+    def test_tasks_listed_with_due_and_ordered(self):
+        store = TaskStore()
+        store.add("ana", "undated")
+        store.add("ana", "later", "2026-12-01")
+        store.add("ana", "sooner", "2026-11-01")
+        store.add("ana", "same-day-b", "2026-11-01")
+        html = render(store)
+        order = [html.index(t) for t in ("sooner", "same-day-b", "later", "undated")]
+        self.assertEqual(order, sorted(order))
+        self.assertIn("2026-11-01", html)
+        self.assertIn("no due date", html)
+
+    def test_overdue_marked_with_text_but_today_is_not(self):
+        store = TaskStore()
+        store.add("ana", "late", "2026-10-29")
+        store.add("ana", "today", "2026-10-30")
+        store.add("ana", "future", "2026-10-31")
+        html = render(store)
+        rows = re.findall(r"<li[^>]*>.*?</li>", html, re.DOTALL)
+        by_title = {t: next(r for r in rows if t in r) for t in ("late", "today", "future")}
+        self.assertIn("OVERDUE", by_title["late"])
+        self.assertIn("overdue", by_title["late"])
+        self.assertNotIn("OVERDUE", by_title["today"])
+        self.assertNotIn("OVERDUE", by_title["future"])
+        self.assertIn("1 overdue", html)
+
+    def test_datetime_style_due_counts_as_overdue(self):
+        store = TaskStore()
+        store.add("ana", "dt", due="2026-10-29T10:00")
+        self.assertIn("OVERDUE", render(store))
+
+    def test_done_overdue_task_not_shown(self):
+        store = TaskStore()
+        tid = store.add("ana", "stale-done", "2020-01-01")
+        store.add("ana", "keep")
+        store.complete("ana", tid)
+        html = render(store)
+        self.assertNotIn("stale-done", html)
+        self.assertNotIn("OVERDUE", html)
+
+    def test_user_data_is_escaped(self):
+        store = TaskStore()
+        store.add("<b>eve</b>", "<script>alert(1)</script>", "<i>x</i>")
+        html = render(store)
+        self.assertNotIn("<script>alert(1)</script>", html)
+        self.assertNotIn("<b>eve</b>", html)
+        self.assertNotIn("<i>x</i>", html)
+        self.assertIn("&lt;script&gt;alert(1)&lt;/script&gt;", html)
+        self.assertIn("&lt;b&gt;eve&lt;/b&gt;", html)
+
+    def test_quotes_in_owner_are_escaped(self):
+        store = TaskStore()
+        store.add('a" onmouseover="x', "t")
+        self.assertNotIn('" onmouseover="x', render(store))
+
+    def test_empty_store_shows_message(self):
+        html = render(TaskStore())
+        self.assertIn("No open tasks", html)
+
+    def test_malformed_due_shown_and_not_overdue(self):
+        store = TaskStore()
+        store.add("ana", "odd", "next tuesday")
+        html = render(store)
+        self.assertIn("next tuesday", html)
+        self.assertNotIn("OVERDUE", html)
+
+    def test_default_today_does_not_crash(self):
+        store = TaskStore()
+        store.add("ana", "ancient", "2000-01-01")
+        self.assertIn("OVERDUE", render_dashboard(store))
+
+
+if __name__ == "__main__":
+    unittest.main()
