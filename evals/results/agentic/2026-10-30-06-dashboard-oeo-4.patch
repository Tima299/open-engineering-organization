@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: Apache-2.0
+import re
+import unittest
+from datetime import date
+
+from taskboard import TaskStore
+from taskboard.dashboard import render_dashboard
+
+TODAY = date(2026, 10, 30)
+
+
+def render(store):
+    return render_dashboard(store, today=TODAY)
+
+
+class DashboardTests(unittest.TestCase):
+    def test_returns_html5_document_with_lang_title_and_viewport(self):
+        html = render(TaskStore())
+        self.assertIsInstance(html, str)
+        self.assertTrue(html.startswith("<!DOCTYPE html>"))
+        self.assertIn('<html lang="en">', html)
+        self.assertIn("<title>", html)
+        self.assertIn('<meta name="viewport" content="width=device-width, initial-scale=1">', html)
+        self.assertEqual(html.count("<h1>"), 1)
+        self.assertEqual(html.count("<main"), 1)
+
+    def test_self_contained_no_external_references(self):
+        store = TaskStore()
+        store.add("ana", "a1", "2026-10-01")
+        html = render(store)
+        for forbidden in ("<link", "<script", "@import", "url(", "http", "@font-face", "<img"):
+            self.assertNotIn(forbidden, html)
+
+    def test_counts_per_owner(self):
+        store = TaskStore()
+        store.add("ana", "a1")
+        store.add("ana", "a2")
+        store.add("ben", "b1")
+        html = render(store)
+        self.assertIn("ana (2)", html)
+        self.assertIn("ben (1)", html)
+        self.assertIn('<span class="num">3</span>', html)  # total card
+
+    def test_done_tasks_excluded_everywhere(self):
+        store = TaskStore()
+        done = store.add("ana", "finished-secret", "2020-01-01")
+        store.add("ana", "pending")
+        store.complete("ana", done)
+        only_done = store.add("ben", "ben-finished")
+        store.complete("ben", only_done)
+        html = render(store)
+        self.assertNotIn("finished-secret", html)
+        self.assertNotIn("ben-finished", html)
+        self.assertNotIn("ben", html)
+        self.assertIn("ana (1)", html)
+        self.assertNotIn("badge overdue", html)
+
+    def test_due_today_is_not_overdue(self):
+        store = TaskStore()
+        store.add("ana", "t", "2026-10-30")
+        html = render(store)
+        self.assertIn("Due 2026-10-30", html)
+        self.assertIn("Due today", html)
+        self.assertNotIn('class="badge overdue"', html)
+        self.assertIn('<span class="num muted">0</span>', html)  # overdue card shows 0
+
+    def test_day_before_is_overdue_with_text_label(self):
+        store = TaskStore()
+        store.add("ana", "t", "2026-10-29")
+        html = render(store)
+        self.assertIn("Due 2026-10-29", html)
+        self.assertRegex(html, r'class="badge overdue">[^<]*Overdue</span>')
+        self.assertIn('class="task overdue"', html)
+        self.assertIn('<span class="num">1</span>', html)
+
+    def test_future_due_has_no_badge(self):
+        store = TaskStore()
+        store.add("ana", "t", "2026-10-31")
+        html = render(store)
+        self.assertIn("Due 2026-10-31", html)
+        self.assertNotIn('class="badge', html)
+
+    def test_no_due_date_label(self):
+        store = TaskStore()
+        store.add("ana", "t")
+        html = render(store)
+        self.assertIn("No due date", html)
+        self.assertNotIn('class="badge', html)
+
+    def test_malformed_due_shown_escaped_never_overdue(self):
+        store = TaskStore()
+        store.add("ana", "t", "<b>soon</b>")
+        store.add("ana", "u", "2026-13-45")
+        html = render(store)
+        self.assertIn("&lt;b&gt;soon&lt;/b&gt;", html)
+        self.assertNotIn("<b>soon", html)
+        self.assertIn("2026-13-45", html)
+        self.assertNotIn('class="badge', html)
+
+    def test_user_text_is_escaped(self):
+        store = TaskStore()
+        store.add('<script>alert(1)</script>', '<script>alert("x")</script>')
+        html = render(store)
+        self.assertNotIn("<script", html)
+        self.assertIn("&lt;script&gt;alert(1)&lt;/script&gt;", html)
+        self.assertIn("&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;", html)
+
+    def test_empty_state(self):
+        for store in (TaskStore(), self._all_done()):
+            html = render(store)
+            self.assertIn('<p role="status">No open tasks.</p>', html)
+            self.assertNotIn('class="card', html)
+            self.assertNotIn("<h3", html)
+
+    def _all_done(self):
+        store = TaskStore()
+        store.complete("ana", store.add("ana", "x"))
+        return store
+
+    def test_as_of_date_and_default_today(self):
+        self.assertIn("As of 2026-10-30", render(TaskStore()))
+        self.assertIn("As of " + date.today().isoformat(), render_dashboard(TaskStore()))
+
+    def test_owners_alphabetical_and_tasks_ordered_by_due_then_id(self):
+        store = TaskStore()
+        store.add("zed", "z1")
+        store.add("ana", "undated-first-added")
+        store.add("ana", "late", "2026-12-01")
+        store.add("ana", "early-a", "2026-11-01")
+        store.add("ana", "early-b", "2026-11-01")
+        store.add("ana", "weird", "someday")
+        html = render(store)
+        self.assertLess(html.index("ana (5)"), html.index("zed (1)"))
+        order = ["early-a", "early-b", "late", "undated-first-added"]
+        positions = [html.index(">%s<" % t) for t in order]
+        self.assertEqual(positions, sorted(positions))
+        self.assertLess(html.index(">late<"), html.index(">weird<"))
+
+    def test_iso_week_date_shown_as_is_never_overdue(self):
+        store = TaskStore()
+        store.add("ana", "t", "2026-W01-1")
+        html = render(store)
+        self.assertIn("Due 2026-W01-1", html)
+        self.assertNotIn('class="badge', html)
+
+    def test_equal_due_dates_keep_insertion_order(self):
+        store = TaskStore()
+        for title in ("third-c", "first-a", "second-b"):
+            store.add("ana", title, "2026-11-01")
+        html = render(store)
+        order = [html.index(">%s<" % t) for t in ("third-c", "first-a", "second-b")]
+        self.assertEqual(order, sorted(order))
+
+    def test_owner_order_is_case_insensitive(self):
+        store = TaskStore()
+        store.add("Zed", "z")
+        store.add("ana", "a")
+        store.add("Ben", "b")
+        html = render(store)
+        self.assertLess(html.index("ana (1)"), html.index("Ben (1)"))
+        self.assertLess(html.index("Ben (1)"), html.index("Zed (1)"))
+
+    def test_border_tokens_meet_3_to_1(self):
+        html = render(TaskStore())
+        self.assertIn("--border:#6f7886", html)
+        self.assertIn("--border:#6e7889", html)
+
+    def test_heading_levels_do_not_skip(self):
+        store = TaskStore()
+        store.add("ana", "t")
+        levels = [int(m) for m in re.findall(r"<h([1-6])", render(store))]
+        self.assertEqual(levels[0], 1)
+        for prev, cur in zip(levels, levels[1:]):
+            self.assertLessEqual(cur - prev, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
