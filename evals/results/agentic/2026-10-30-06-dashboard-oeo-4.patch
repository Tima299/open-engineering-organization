+# SPDX-License-Identifier: Apache-2.0
+"""Dashboard: one self-contained HTML page of open tasks per owner."""
+import re
+from datetime import date
+from html import escape
+
+from .reporting import open_task_counts
+
+_CSS = """
+:root{color-scheme:light dark;--bg:#f6f7f9;--surface:#ffffff;--text:#1a1d21;--muted:#4a5260;
+--border:#6f7886;--accent:#1f4fbf;--overdue-fg:#a4111a;--overdue-bg:#fdecec;
+--today-fg:#7a4a00;--today-bg:#fff4d6}
+@media (prefers-color-scheme:dark){:root{--bg:#0f1217;--surface:#181c23;--text:#e8eaee;
+--muted:#a9b1bd;--border:#6e7889;--accent:#8fb4ff;--overdue-fg:#ffb4ab;--overdue-bg:#3d1417;
+--today-fg:#ffd98a;--today-bg:#3a2c08}}
+*{box-sizing:border-box}
+body{margin:0;padding:16px;background:var(--bg);color:var(--text);
+font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
+.wrap{max-width:960px;margin:0 auto}
+h1{font-size:28px;font-weight:700;margin:0}
+h2{font-size:20px;font-weight:600;margin:24px 0 12px}
+h3{font-size:16px;font-weight:600;margin:0 0 8px;overflow-wrap:anywhere}
+p{margin:0}
+ul{list-style:none;margin:0;padding:0}
+.meta,.sub,footer{font-size:14px;color:var(--muted)}
+.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;
+min-width:0;overflow-wrap:anywhere}
+.card.total{grid-column:span 2}
+.card.overdue{border-left:4px solid var(--overdue-fg)}
+.card.overdue .label{color:var(--overdue-fg);font-weight:700}
+.num{display:block;font-size:32px;font-weight:700;line-height:1.2;font-variant-numeric:tabular-nums}
+.num.muted{color:var(--muted)}
+.label{font-size:14px;color:var(--muted)}
+.owners{display:block}
+.owner{margin-bottom:24px;break-inside:avoid}
+.task{display:flex;flex-direction:column;gap:4px;background:var(--surface);
+border:1px solid var(--border);border-radius:8px;padding:12px 16px;margin-bottom:8px}
+.task.overdue{background:var(--overdue-bg);border-left:4px solid var(--overdue-fg)}
+.task.today{background:var(--today-bg)}
+.title{overflow-wrap:anywhere;min-width:0}
+.due{font-size:14px;color:var(--muted)}
+.due.none{font-style:italic}
+.task.overdue .due{color:var(--overdue-fg)}
+.task.today .due{color:var(--today-fg)}
+.badge{display:inline-block;font-size:14px;font-weight:700;border-radius:8px;padding:0 8px;
+margin-left:8px}
+.badge.overdue{color:var(--overdue-fg);border:1px solid var(--overdue-fg)}
+.badge.today{color:var(--today-fg);border:1px solid var(--today-fg)}
+footer{margin-top:24px}
+@media (min-width:600px){
+.cards{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
+.card.total{grid-column:auto}
+.task{flex-direction:row;justify-content:space-between;align-items:baseline;gap:12px}
+.task .meta{flex:none;text-align:right}}
+@media (min-width:960px){
+.owners{column-count:2;column-gap:24px}}
+"""
+
+
+def _parse_due(due):
+    """Return a date for a strict YYYY-MM-DD string, else None."""
+    if not isinstance(due, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", due):
+        return None
+    try:
+        return date.fromisoformat(due)
+    except ValueError:
+        return None
+
+
+def _open_tasks(store):
+    rows = store.conn.execute(
+        "SELECT id, owner, title, due FROM tasks WHERE done = 0 ORDER BY id").fetchall()
+    return [dict(r) for r in rows]
+
+
+def _sort_key(task):
+    parsed = _parse_due(task["due"])
+    if parsed is not None:
+        return (0, parsed, task["id"])
+    # malformed dates sort with undated tasks, after real dates
+    return (1, date.max, task["id"])
+
+
+def _task_html(task, today):
+    parsed = _parse_due(task["due"])
+    css, badge = "task", ""
+    if task["due"] is None or task["due"] == "":
+        due_html = '<span class="due none">No due date</span>'
+    else:
+        due_html = '<span class="due">Due %s</span>' % escape(task["due"])
+        if parsed is not None and parsed < today:
+            css += " overdue"
+            badge = '<span class="badge overdue">! Overdue</span>'
+        elif parsed == today:
+            css += " today"
+            badge = '<span class="badge today">Due today</span>'
+    return ('<li class="%s"><span class="title">%s</span>'
+            '<span class="meta">%s%s</span></li>'
+            % (css, escape(task["title"]), due_html, badge))
+
+
+def render_dashboard(store, today=None):
+    """Return a self-contained HTML5 page listing open tasks per owner."""
+    today = today or date.today()
+    counts = open_task_counts(store)
+    by_owner = {}
+    for task in _open_tasks(store):
+        by_owner.setdefault(task["owner"], []).append(task)
+
+    owners = sorted(counts, key=lambda o: (o.casefold(), o))
+    overdue = sum(
+        1 for tasks in by_owner.values() for t in tasks
+        if (_parse_due(t["due"]) or today) < today)
+
+    parts = ['<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+             '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+             '<meta name="color-scheme" content="light dark">\n'
+             '<title>Open tasks</title>\n<style>%s</style>\n</head>\n<body>\n<div class="wrap">\n'
+             '<header><h1>Open tasks</h1><p class="meta">As of %s</p></header>\n<main>\n'
+             % (_CSS, today.isoformat())]
+    if not owners:
+        parts.append('<p role="status">No open tasks.</p>\n'
+                     '<p class="sub">Everything is done, or nothing has been added yet.</p>\n')
+    else:
+        parts.append('<section aria-labelledby="summary"><h2 id="summary">Summary</h2>\n'
+                     '<ul class="cards">\n')
+        parts.append('<li class="card total"><span class="num">%d</span>'
+                     '<span class="label">Total open</span></li>\n' % sum(counts.values()))
+        if overdue:
+            parts.append('<li class="card overdue"><span class="num">%d</span>'
+                         '<span class="label">Overdue</span></li>\n' % overdue)
+        else:
+            parts.append('<li class="card"><span class="num muted">0</span>'
+                         '<span class="label">Overdue</span></li>\n')
+        for owner in owners:
+            parts.append('<li class="card"><span class="label">%s</span>'
+                         '<span class="num">%d</span><span class="label">open</span></li>\n'
+                         % (escape(owner), counts[owner]))
+        parts.append('</ul></section>\n<section aria-labelledby="by-owner">'
+                     '<h2 id="by-owner">Tasks by owner</h2>\n<div class="owners">\n')
+        for i, owner in enumerate(owners):
+            tasks = sorted(by_owner[owner], key=_sort_key)
+            parts.append('<section class="owner" aria-labelledby="owner-%d">'
+                         '<h3 id="owner-%d">%s (%d)</h3>\n<ul>\n' % (i, i, escape(owner), len(tasks)))
+            parts.extend(_task_html(t, today) + "\n" for t in tasks)
+            parts.append('</ul></section>\n')
+        parts.append('</div></section>\n')
+    parts.append('</main>\n</div>\n</body>\n</html>\n')
+    return "".join(parts)
