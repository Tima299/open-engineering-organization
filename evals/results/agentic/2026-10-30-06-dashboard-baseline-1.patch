+# SPDX-License-Identifier: Apache-2.0
+"""Dashboard: open-task counts per owner and each owner's open tasks, as one HTML document."""
+import datetime
+from html import escape
+
+from .reporting import open_task_counts
+
+_CSS = """
+:root{--bg:#f6f7f9;--card:#fff;--fg:#1c2530;--muted:#667085;--line:#e4e7ec;--accent:#2f6fed;
+--bad:#b42318;--bad-bg:#fee4e2}
+@media (prefers-color-scheme:dark){:root{--bg:#12161c;--card:#1b222b;--fg:#e8ecf1;--muted:#98a2b3;
+--line:#2b3440;--accent:#6b9bff;--bad:#ffb4ab;--bad-bg:#4a1f1b}}
+*{box-sizing:border-box}
+body{margin:0;padding:16px;background:var(--bg);color:var(--fg);
+font:15px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}
+main{max-width:1100px;margin:0 auto}
+h1{font-size:1.4rem;margin:0 0 4px}
+.sub{color:var(--muted);margin:0 0 20px}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
+.card h2{display:flex;justify-content:space-between;align-items:center;gap:8px;
+font-size:1.05rem;margin:0 0 10px;overflow-wrap:anywhere}
+.count{background:var(--accent);color:#fff;border-radius:999px;padding:1px 10px;font-size:.85rem}
+ul{list-style:none;margin:0;padding:0}
+li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid var(--line)}
+.title{overflow-wrap:anywhere}
+.due{color:var(--muted);white-space:nowrap;font-size:.9rem}
+li.overdue .due{color:var(--bad);font-weight:600}
+li.overdue{background:var(--bad-bg);margin:0 -8px;padding:8px;border-radius:6px}
+.empty{color:var(--muted)}
+"""
+
+
+def _due_cell(due, today):
+    if not due:
+        return "no due date", False
+    try:
+        overdue = datetime.date.fromisoformat(due) < today
+    except ValueError:
+        return escape(due), False
+    return escape(due) + (" (overdue)" if overdue else ""), overdue
+
+
+def render_dashboard(store, today=None):
+    """Return a self-contained HTML document for `store`; `today` defaults to the current date."""
+    today = today or datetime.date.today()
+    counts = open_task_counts(store)
+    rows = store.conn.execute(
+        "SELECT owner, title, due FROM tasks WHERE done = 0 "
+        "ORDER BY owner, due IS NULL, due, id").fetchall()
+    by_owner = {}
+    for row in rows:
+        by_owner.setdefault(row["owner"], []).append(row)
+
+    cards = []
+    for owner in sorted(counts):
+        items = []
+        for task in by_owner.get(owner, []):
+            due_text, overdue = _due_cell(task["due"], today)
+            items.append(
+                f'<li class="{"overdue" if overdue else ""}">'
+                f'<span class="title">{escape(task["title"])}</span>'
+                f'<span class="due">{due_text}</span></li>')
+        cards.append(
+            f'<section class="card"><h2><span>{escape(owner)}</span>'
+            f'<span class="count">{counts[owner]} open</span></h2>'
+            f'<ul>{"".join(items)}</ul></section>')
+    body = "".join(cards) or '<p class="empty">No open tasks.</p>'
+    return (
+        '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
+        '<meta name="viewport" content="width=device-width,initial-scale=1">'
+        f'<title>Taskboard dashboard</title><style>{_CSS}</style></head><body><main>'
+        f'<h1>Taskboard</h1><p class="sub">Open tasks per owner &middot; as of {today.isoformat()}</p>'
+        f'<div class="grid">{body}</div></main></body></html>')
