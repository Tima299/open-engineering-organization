@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: Apache-2.0
+import datetime
+import unittest
+
+from taskboard import TaskStore
+from taskboard.dashboard import render_dashboard
+
+
+class DashboardTests(unittest.TestCase):
+    def test_counts_overdue_and_escaping(self):
+        store = TaskStore()
+        store.add("ana", "late <b>", due="2020-01-01")
+        store.add("ana", "later", due="2099-01-01")
+        done = store.add("ana", "finished", due="2020-01-01")
+        store.complete("ana", done)
+        store.add("ben", "no date")
+        html = render_dashboard(store, today=datetime.date(2030, 1, 1))
+        self.assertIn("2 open", html)
+        self.assertIn("1 open", html)
+        self.assertIn("late &lt;b&gt;", html)
+        self.assertEqual(html.count('<li class="overdue">'), 1)
+        self.assertNotIn("finished", html)
+
+    def test_empty(self):
+        self.assertIn("No open tasks", render_dashboard(TaskStore()))
+
+
+if __name__ == "__main__":
+    unittest.main()
