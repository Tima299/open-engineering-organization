+# SPDX-License-Identifier: Apache-2.0
+"""Dashboard: one self-contained HTML page of open tasks per owner."""
+import datetime
+import html
+import re
+
+from .reporting import open_task_counts
+
+_ISO_DATE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
+
+_CSS = """
+:root{color-scheme:light dark;--bg:#f6f7f9;--surface:#ffffff;--text:#1a1d23;--muted:#555b66;
+--border:#767c88;--overdue-fg:#9b1c1c;--overdue-bg:#fdecec;--focus:#0b5cad}
+@media (prefers-color-scheme:dark){:root{--bg:#14161a;--surface:#1e2127;--text:#e8eaee;
+--muted:#a9afba;--border:#6b7380;--overdue-fg:#ffb4b4;--overdue-bg:#3a1d1f;--focus:#7db6f5}}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--text);line-height:1.5;
+font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
+.container{padding:16px}
+header,section{margin-bottom:24px}
+h1,h2{line-height:1.3;margin:0 0 8px}
+.sub{color:var(--muted);margin:0}
+.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;
+clip:rect(0,0,0,0);white-space:nowrap;border:0}
+.cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
+.cards li{min-width:0}
+.card{display:flex;gap:8px;justify-content:space-between;align-items:flex-start;min-height:44px;
+height:100%;padding:12px;background:var(--surface);color:var(--text);text-decoration:none;
+border:1px solid var(--border);border-radius:8px}
+.card.has-overdue{border-left:4px solid var(--overdue-fg)}
+.name{min-width:0;overflow-wrap:anywhere;line-height:1.3;font-weight:600}
+.count{flex:none;text-align:right}
+.count b{display:block;font-size:1.75rem;line-height:1.1}
+.count span{color:var(--muted);font-size:.875rem}
+.card .od{display:block;color:var(--overdue-fg);font-weight:700;font-size:.875rem}
+a:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
+table{width:100%;border-collapse:collapse;table-layout:auto;background:var(--surface);
+border:1px solid var(--border)}
+thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
+tr{display:block;border-bottom:1px solid var(--border);padding:8px 12px}
+td{display:block;min-width:0;padding:2px 0}
+td::before{content:attr(data-label) ": ";color:var(--muted);font-size:.875rem}
+td.title{overflow-wrap:anywhere;word-break:normal;hyphens:auto}
+td.title::before{content:none}
+tr.overdue{border-left:4px solid var(--overdue-fg);background:var(--overdue-bg)}
+tr.overdue td.due{font-weight:700}
+tr.overdue td.status{color:var(--overdue-fg);font-weight:700}
+.muted{color:var(--muted);font-style:italic}
+.empty{text-align:center;padding:32px;background:var(--surface);border:2px dashed var(--border)}
+@media (min-width:600px){
+.cards{grid-template-columns:repeat(auto-fill,minmax(10rem,1fr))}
+thead{position:static;width:auto;height:auto;overflow:visible;clip:auto}
+table{display:table}
+tr{display:table-row;padding:0}
+th,td{display:table-cell;padding:8px 12px;text-align:left;border-bottom:1px solid var(--border)}
+td::before{content:none}
+td.due,td.status{white-space:nowrap}
+tr.overdue td:first-child{border-left:4px solid var(--overdue-fg)}
+tr.overdue{border-left:0}
+}
+@media (min-width:960px){.container{max-width:60rem;margin:0 auto;padding:32px}}
+"""
+
+
+def _esc(value):
+    return html.escape(str(value), quote=True)
+
+
+def _parse_date(value):
+    if isinstance(value, str) and _ISO_DATE.match(value):
+        try:
+            return datetime.date.fromisoformat(value)
+        except ValueError:
+            return None
+    return None
+
+
+def _task_sort_key(task):
+    due = task["due"]
+    if due is None or due == "":
+        group, key = 2, ""
+    else:
+        parsed = _parse_date(due)
+        group, key = (0, parsed.isoformat()) if parsed else (1, str(due))
+    return (group, key, task["id"])
+
+
+def _classify(task, today):
+    """Return (state, days_overdue) with state in overdue/today/upcoming/invalid/none."""
+    due = task["due"]
+    if due is None or due == "":
+        return "none", 0
+    parsed = _parse_date(due)
+    if parsed is None:
+        return "invalid", 0
+    if parsed < today:
+        return "overdue", (today - parsed).days
+    if parsed == today:
+        return "today", 0
+    return "upcoming", 0
+
+
+def _row(task, today):
+    state, days = _classify(task, today)
+    title = _esc(task["title"])
+    if state == "none":
+        due = '<span class="muted">No due date</span>'
+        status = '<span class="muted">-</span>'
+    elif state == "invalid":
+        due, status = _esc(task["due"]), "Invalid date"
+    else:
+        due = _esc(task["due"])
+        if state == "overdue":
+            plural = "" if days == 1 else "s"
+            status = ('<span aria-hidden="true">! </span>Overdue '
+                      f'&middot; {days} day{plural}')
+        else:
+            status = "Due today" if state == "today" else "Upcoming"
+    cls = ' class="overdue"' if state == "overdue" else ""
+    return (f'<tr{cls}><td class="title" data-label="Task">{title}</td>'
+            f'<td class="due" data-label="Due">{due}</td>'
+            f'<td class="status" data-label="Status">{status}</td></tr>')
+
+
+def render_dashboard(store, today=None):
+    """Return a complete, self-contained HTML5 document of open tasks per owner."""
+    if today is None:
+        today = datetime.date.today()
+    elif isinstance(today, datetime.datetime):
+        today = today.date()
+    counts = open_task_counts(store)
+    rows = store.conn.execute(
+        "SELECT id, owner, title, due FROM tasks WHERE done = 0 ORDER BY id").fetchall()
+    by_owner = {}
+    for row in rows:
+        by_owner.setdefault(row["owner"], []).append(dict(row))
+    owners = sorted(counts, key=lambda o: (o.casefold(), o))
+    total = sum(counts.values())
+
+    parts = [
+        '<!DOCTYPE html>\n<html lang="en"><head><meta charset="utf-8">'
+        '<meta name="viewport" content="width=device-width, initial-scale=1">'
+        f"<title>Taskboard: open tasks</title><style>{_CSS}</style></head>"
+        '<body><main class="container"><header><h1>Open tasks</h1>'
+        f'<p class="sub">As of {_esc(today.isoformat())} &middot; {total} open</p></header>'
+    ]
+    if not owners:
+        parts.append('<section class="empty" aria-labelledby="empty-h">'
+                     '<h2 id="empty-h">No open tasks</h2>'
+                     "<p>Nothing is waiting on anyone. Add tasks with the taskboard CLI.</p>"
+                     "</section>")
+    else:
+        cards, sections = [], []
+        for n, owner in enumerate(owners, 1):
+            tasks = sorted(by_owner.get(owner, []), key=_task_sort_key)
+            overdue = sum(1 for t in tasks if _classify(t, today)[0] == "overdue")
+            n_open = counts[owner]
+            od = f'<span class="od">{overdue} overdue</span>' if overdue else ""
+            flag = " has-overdue" if overdue else ""
+            cards.append(
+                f'<li><a class="card{flag}" href="#owner-{n}">'
+                f'<span class="name">{_esc(owner)}{od}</span>'
+                f'<span class="count"><b>{n_open}</b><span>open tasks</span></span></a></li>')
+            body = "".join(_row(t, today) for t in tasks)
+            sections.append(
+                f'<section id="owner-{n}" aria-labelledby="owner-{n}-h">'
+                f'<h2 id="owner-{n}-h">{_esc(owner)} ({n_open} open)</h2><table>'
+                f'<caption class="sr-only">Open tasks for {_esc(owner)}</caption>'
+                '<thead><tr><th scope="col">Task</th><th scope="col">Due</th>'
+                f'<th scope="col">Status</th></tr></thead><tbody>{body}</tbody></table></section>')
+        parts.append('<section aria-labelledby="by-owner">'
+                     '<h2 id="by-owner">Open tasks by owner</h2>'
+                     f'<ul class="cards">{"".join(cards)}</ul></section>')
+        parts.extend(sections)
+    parts.append("</main></body></html>\n")
+    return "".join(parts)
diff --git a/tests/test_dashboard.py b/tests/test_dashboard.py
new file mode 100644
index 0000000..e13f1f2
--- /dev/null
+++ b/tests/test_dashboard.py
@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: Apache-2.0
+import datetime
+import re
+import unittest
+
+from taskboard import TaskStore
+from taskboard.dashboard import render_dashboard
+
+TODAY = datetime.date(2026, 10, 30)
+
+DARK_MARK = "@media (prefers-color-scheme:dark){:root{"
+
+
+def _tokens(block):
+    return dict(re.findall(r"--([a-z-]+):(#[0-9a-fA-F]{6})", block))
+
+
+def _lum(hex_color):
+    chans = []
+    for i in (1, 3, 5):
+        c = int(hex_color[i:i + 2], 16) / 255
+        chans.append(c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4)
+    return 0.2126 * chans[0] + 0.7152 * chans[1] + 0.0722 * chans[2]
+
+
+def contrast(a, b):
+    hi, lo = sorted((_lum(a), _lum(b)), reverse=True)
+    return (hi + 0.05) / (lo + 0.05)
+
+
+def render(store):
+    return render_dashboard(store, today=TODAY)
+
+
+class DashboardTests(unittest.TestCase):
+    def test_complete_self_contained_document(self):
+        store = TaskStore()
+        store.add("ana", "a1", "2026-11-01")
+        out = render(store)
+        self.assertTrue(out.startswith("<!DOCTYPE html>"))
+        self.assertIn('<html lang="en">', out)
+        self.assertIn('name="viewport"', out)
+        self.assertIn("<style>", out)
+        self.assertNotIn("<script", out)
+        self.assertNotIn("<link", out)
+        self.assertNotIn("<img", out)
+        self.assertIsNone(re.search(r"(src|href)\s*=\s*[\"']?(https?:)?//", out))
+        self.assertNotIn("http://", out)
+        self.assertNotIn("https://", out)
+        self.assertNotIn("url(", out)
+        self.assertNotIn("@import", out)
+
+    def test_counts_exclude_done_and_omit_owners_without_open(self):
+        store = TaskStore()
+        store.add("ana", "a1")
+        store.add("ana", "a2")
+        done = store.add("ben", "finished-task")
+        store.complete("ben", done)
+        out = render(store)
+        self.assertIn("<h2", out)
+        self.assertIn("ana (2 open)", out)
+        self.assertIn("<b>2</b>", out)
+        self.assertIn("2 open", out)
+        self.assertNotIn("ben", out)
+        self.assertNotIn("finished-task", out)
+
+    def test_empty_state(self):
+        out = render(TaskStore())
+        self.assertIn("No open tasks", out)
+        self.assertIn("Nothing is waiting on anyone", out)
+        self.assertNotIn("<table", out)
+        self.assertNotIn('<ul class="cards"', out)
+        self.assertIn("0 open", out)
+
+    def test_all_done_is_empty_state(self):
+        store = TaskStore()
+        store.complete("ana", store.add("ana", "x"))
+        self.assertIn("No open tasks", render(store))
+
+    def test_ordering(self):
+        store = TaskStore()
+        store.add("zed", "z-task")
+        store.add("amy", "undated-first-id")
+        store.add("amy", "late", "2026-12-01")
+        store.add("amy", "early-b", "2026-01-01")
+        store.add("amy", "early-a", "2026-01-01")
+        out = render(store)
+        self.assertLess(out.index("amy ("), out.index("zed ("))
+        order = ["early-b", "early-a", "late", "undated-first-id"]
+        positions = [out.index(f'data-label="Task">{t}<') for t in order]
+        self.assertEqual(positions, sorted(positions))
+        self.assertIn("No due date", out)
+
+    def test_overdue_vs_due_today(self):
+        store = TaskStore()
+        store.add("ana", "old", "2026-10-28")
+        store.add("ana", "now", "2026-10-30")
+        store.add("ana", "later", "2026-10-31")
+        out = render(store)
+        rows = re.findall(r"<tr[^>]*>.*?</tr>", out)
+        by = {t: r for r in rows for t in ("old", "now", "later") if f">{t}<" in r}
+        self.assertIn('class="overdue"', by["old"])
+        self.assertIn("Overdue", by["old"])
+        self.assertIn("Overdue &middot; 2 days", by["old"])
+        self.assertNotIn("days overdue", by["old"])
+        self.assertNotIn("overdue", by["now"].lower())
+        self.assertIn("Due today", by["now"])
+        self.assertNotIn("overdue", by["later"].lower())
+        self.assertIn("Upcoming", by["later"])
+        self.assertIn("1 overdue", out)
+        self.assertIn("border-left:4px solid var(--overdue-fg)", out)
+
+    def test_no_overdue_label_on_card_when_none(self):
+        store = TaskStore()
+        store.add("ana", "x", "2026-10-30")
+        self.assertNotIn(" overdue<", render(store))
+
+    def test_bad_due_values_do_not_crash(self):
+        store = TaskStore()
+        for bad in ("garbage", "2026-13-45", "2026-W01-1", "", "30/10/2026"):
+            store.add("ana", "t" + bad, bad)
+        out = render(store)
+        self.assertIn("Invalid date", out)
+        self.assertIn("garbage", out)
+        self.assertNotIn("Overdue", out)
+
+    def test_card_has_overdue_class_only_when_overdue(self):
+        store = TaskStore()
+        store.add("ana", "old", "2026-10-01")
+        store.add("ben", "fine", "2026-12-01")
+        out = render(store)
+        cards = re.findall(r'<a class="(card[^"]*)" href[^>]*><span class="name">(\w+)', out)
+        self.assertEqual(dict((o, c) for c, o in cards),
+                         {"ana": "card has-overdue", "ben": "card"})
+        self.assertEqual(out.count('class="card has-overdue"'), 1)
+
+    def test_non_ascii_digits_are_invalid(self):
+        store = TaskStore()
+        store.add("ana", "arabic", "\u0662\u0660\u0662\u0666-\u0661\u0660-\u0662\u0669")
+        out = render(store)
+        self.assertIn("Invalid date", out)
+        self.assertNotIn("Overdue", out)
+
+    def test_default_today_is_used(self):
+        store = TaskStore()
+        out = render_dashboard(store)
+        self.assertIn(f"As of {datetime.date.today().isoformat()}", out)
+
+    def test_html_escaping(self):
+        payload = '<script>alert("x")</script>'
+        store = TaskStore()
+        store.add(payload, payload, payload)
+        out = render(store)
+        self.assertNotIn("<script", out)
+        self.assertNotIn(payload, out)
+        self.assertIn("&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;", out)
+
+    def test_responsive_and_accessible_markup(self):
+        store = TaskStore()
+        store.add("ana", "a")
+        out = render(store)
+        self.assertIn("@media (min-width:600px)", out)
+        self.assertIn("@media (min-width:960px)", out)
+        self.assertIn("@media (prefers-color-scheme:dark){:root{", out)
+        dark = out.split("@media (prefers-color-scheme:dark){:root{", 1)[1].split("}}", 1)[0]
+        for tok in ("--bg:#14161a", "--surface:#1e2127", "--text:#e8eaee",
+                    "--muted:#a9afba", "--border:#6b7380", "--overdue-fg:#ffb4b4",
+                    "--overdue-bg:#3a1d1f", "--focus:#7db6f5"):
+            self.assertIn(tok, dark)
+        light_block = out.split("<style>", 1)[1].split(DARK_MARK, 1)[0]
+        for name, block in (("light", light_block), ("dark", dark)):
+            t = _tokens(block)
+            self.assertEqual(len(t), 8, name)
+            for fg, bg in (("text", "surface"), ("muted", "surface"),
+                           ("overdue-fg", "overdue-bg")):
+                self.assertGreaterEqual(contrast(t[fg], t[bg]), 4.5, f"{name} {fg}/{bg}")
+            self.assertGreaterEqual(contrast(t["border"], t["surface"]), 3, f"{name} border")
+        self.assertIn("<main", out)
+        self.assertEqual(out.count("<h1"), 1)
+        self.assertIn('<th scope="col">Task</th>', out)
+        self.assertIn('href="#owner-1"', out)
+        self.assertIn('id="owner-1"', out)
+        self.assertIn("focus-visible", out)
+
+    def test_open_and_done_task_same_owner(self):
+        store = TaskStore()
+        store.add("cat", "open-one")
+        store.complete("cat", store.add("cat", "done-one"))
+        out = render(store)
+        self.assertIn("open-one", out)
+        self.assertNotIn("done-one", out)
+        self.assertIn("cat (1 open)", out)
+        self.assertIn("<b>1</b>", out)
+
+    def test_singular_day_and_card_label(self):
+        store = TaskStore()
+        store.add("ana", "y", "2026-10-29")
+        out = render(store)
+        self.assertIn("Overdue &middot; 1 day<", out)
+        self.assertIn("<span>open tasks</span>", out)
+
+    def test_empty_state_labelled(self):
+        out = render(TaskStore())
+        self.assertIn('aria-labelledby="empty-h"', out)
+        self.assertIn('id="empty-h"', out)
+
+    def test_datetime_today_is_normalized(self):
+        store = TaskStore()
+        store.add("ana", "x", "2026-10-29")
+        out = render_dashboard(store, today=datetime.datetime(2026, 10, 30, 15, 30))
+        self.assertIn("As of 2026-10-30", out)
+        self.assertIn("Overdue &middot; 1 day<", out)
+
+    def test_owner_sort_is_case_insensitive(self):
+        store = TaskStore()
+        for o in ("bob", "Alice", "alice", "Carl"):
+            store.add(o, "t-" + o)
+        out = render(store)
+        names = re.findall(r'<h2 id="owner-\d+-h">(.*?) \(', out)
+        self.assertEqual(names, ["Alice", "alice", "bob", "Carl"])
+
+
+if __name__ == "__main__":
+    unittest.main()
