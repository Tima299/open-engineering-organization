     def delete(self, requester, task_id):
-        """Delete a task. Returns True if a task was removed."""
-        cur = self.conn.execute("DELETE FROM tasks WHERE id = ?", (task_id,))
+        """Delete `requester`'s own task. Returns True if a task was removed.
+
+        Another owner's task and an unknown id both return False, so a caller
